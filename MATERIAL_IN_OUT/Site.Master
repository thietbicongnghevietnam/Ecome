    <style>

        /* ===== HEADER TOP ===== */
        .header-top-area {
            background: #004b8d !important;
        }

        .header-right-info .nav-link {
            color: #ffffff !important;
        }

        /* ===== BUTTON PRIMARY ===== */
        .btn-info, .btn-primary {
            background-color: #0070c0 !important;
            border-color: #0070c0 !important;
        }

            .btn-info:hover, .btn-primary:hover {
                background-color: #004b8d !important;
            }

        /* ===== CONTENT BACKGROUND ===== */
        .all-content-wrapper {
            background-color: #f4f8fb !important;
        }

        /* ===== DROPDOWN ===== */
        .dropdown-menu {
            border-radius: 8px;
        }

        /* Main sidebar container */
#sidebar {
    background-color: #0062AF !important; /* Panasonic Blue */
    color: #ffffff !important;
}

/* Sidebar header */
.sidebar-header {
    background-color: #004B87 !important; /* Darker Panasonic Blue */
    color: #ffffff !important;
    padding: 15px;
    height: 57px;
}

.sidebar-header .brand-text {
    color: #ffffff !important;
    text-decoration: none;
}

.logo-pro {
    color: #ffffff !important;
    font-weight: bold;
}

/* Navigation menu */
.sidebar-nav {
    background-color: #0062AF !important;
}

/* Fix cho menu1 - background trắng */
#menu1 {
    background-color: #0062AF !important;
    margin: 0 !important;
    padding: 0 !important;
}

.metismenu {
    background-color: #0062AF !important;
}

.metismenu li {
    background-color: #0062AF !important;
    border: none !important;
}

.metismenu li a {
    color: #ffffff !important;
    background-color: transparent !important;
    padding: 12px 20px !important;
    transition: background-color 0.3s ease;
    display: block !important;
}

.metismenu li a:hover {
    background-color: #004B87 !important; /* Darker blue on hover */
    color: #ffffff !important;
    border-left: 4px solid #ffffff;
}

.metismenu li a.active,
.metismenu li a:active,
.metismenu li a:focus {
    background-color: #003D6E !important; /* Even darker for active state */
    color: #ffffff !important;
}

/* Icons */
.metismenu li a i {
    color: #ffffff !important;
    margin-right: 10px;
}

.metismenu li a .mini-click-non {
    color: #ffffff !important;
}

/* Scrollbar customization */
.left-custom-menu-adp-wrap {
    background-color: #0062AF !important;
}

.left-sidebar-menu-pro {
    background-color: #0062AF !important;
}

.mCSB_container {
    background-color: #0062AF !important;
}

/* Link styles - tất cả hyperlinks */
#linkMaterialA,
#linkMaterialB,
#linkPUR_CDS,
#linkInvoice,
#linkIncharge,
#linkDownload,
#linkUser,
#lnkDownloadExcel,
#linkIssueControl {
    color: #ffffff !important;
    background-color: transparent !important;
}

/* Scrollbar styling */
.mCSB_scrollTools {
    background-color: rgba(0, 75, 135, 0.3) !important;
}

.mCSB_dragger_bar {
    background-color: #ffffff !important;
}

/* Left sidebar wrapper */
.left-sidebar-pro {
    background-color: #0062AF !important;
}

/* Remove any borders */
.metismenu li,
.metismenu li a {
    border: none !important;
    border-bottom: none !important;
}
        

.brand-text {
    font-family: 'Roboto', sans-serif; /* hoặc font Panasonic nếu có */
    font-weight: 100;
    font-size: clamp(12px, 4vw, 16px); /* cỡ chữ co giãn theo viewport */
    color: #004b8d;
    text-decoration: none;
    display: block;
    white-space: nowrap;       /* Không xuống dòng */
    overflow: hidden;          /* Ẩn chữ tràn */
    text-overflow: ellipsis;   /* Hiển thị dấu ... nếu quá dài */
    text-align: center;
    padding-top:17px;
}

.brand-text:hover {
    color: #0070c0;                      /* Màu xanh nhạt khi hover */
}  

/* Dropdown menu background luôn xanh Panasonic */
.dropdown-header-top.author-log.dropdown-menu {
    background-color: #004B8D !important; /* màu xanh Panasonic */
    border: none; /* bỏ border nếu có */
}

/* Chữ menu trắng */
.dropdown-header-top.author-log.dropdown-menu li a {
    color: #ffffff !important;
}

/* Hover mỗi item vẫn sáng hơn */
.dropdown-header-top.author-log.dropdown-menu li a:hover {
    background-color: #005BAC !important;
    color: #ffffff !important;
}

/* Hover toàn bộ menu item sidebar */
.metismenu li a:hover,
.metismenu li a:focus {
    color: #FFD700 !important; /* màu vàng */
}

/* Nếu có icon bên trong vẫn đổi màu vàng luôn */
.metismenu li a:hover i,
.metismenu li a:focus i {
    color: #FFD700 !important;
}

/* Nếu bạn muốn nền menu cũng đổi màu khi hover (tùy chọn) */
.metismenu li a:hover {
    background-color: rgba(255, 215, 0, 0.1); /* nền vàng nhạt */
}


/* Tiêu đề table xanh Panasonic */
#table thead th {
    background-color: #004B8D; /* nền xanh Panasonic */
    color: #ffffff;            /* chữ trắng */
    border-color: #003766;     /* viền xanh đậm hơn (tùy chọn) */
    text-align: center;        /* canh giữa chữ nếu muốn */
}

/* Nếu muốn hover row vẫn nổi bật */
#table tbody tr:hover {
    background-color: rgba(0, 75, 141, 0.1); /* xanh nhạt khi hover */
}


#sidebarCollapse {
    margin-left: 20px;  /* cách trái 10px, chỉnh tùy ý */
    /*margin-top: 5px;*/    /* cách trên 5px, chỉnh tùy ý */
    /*margin-right: 10px;*/ /* cách phải 10px nếu cần */
    /*margin-bottom: 5px;*/ /* cách dưới 5px nếu cần */
}

    </style>


